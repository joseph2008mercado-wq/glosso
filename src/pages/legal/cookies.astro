---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { site } from '../../data/site';
---
<Base title="Cookie Policy">
  <PageIntro eyebrow="Legal" title="Cookie Policy" />
  <section class="wrap legal-body"><aside><a class="back-link" href="/legal/">← Legal</a></aside><div class="prose">
    <h2>Cookies on this site</h2>
    <p>Glosso’s website code does not set cookies or store visitor information in your browser. Cloudflare security features may set cookies to protect the site, depending on which features are enabled.</p>
    <h2>Cloudflare</h2>
    <p>Cloudflare Web Analytics, when enabled, does not use cookies or local storage for usage metrics. Details: <a href="https://www.cloudflare.com/web-analytics/">Web Analytics</a> and <a href="https://developers.cloudflare.com/fundamentals/reference/policies-compliances/cloudflare-cookies/">Cloudflare security cookies</a>.</p>
    <h2>Your browser controls</h2>
    <p>You can review, delete or block cookies in your browser settings. Blocking security cookies may affect security checks.</p>
    <h2>Questions</h2>
    <p>Contact <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> or see our <a href="/legal/privacy/">Privacy Policy</a>.</p>
  </div></section>
</Base>
