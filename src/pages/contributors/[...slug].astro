---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { render, type CollectionEntry } from 'astro:content';
import { publishedContributors, publishedWriting } from '../../lib/content';

export async function getStaticPaths() {
  const people = await publishedContributors();
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

interface Props { person: CollectionEntry<'contributors'>; }
const { person } = Astro.props;
const { Content } = await render(person);
const works = (await publishedWriting()).filter((work) => work.data.contributors.includes(person.id));
---
<Base title={person.data.name} image={person.data.portrait} imageAlt={person.data.portraitAlt} structuredData={{ '@context': 'https://schema.org', '@type': 'ProfilePage', url: new URL(`/contributors/${person.id}/`, Astro.site).href, mainEntity: { '@type': 'Person', name: person.data.name } }}>
  <header class="wrap work-header"><a class="back-link" href="/contributors/">← Contributors</a><div class="work-info"><span>{person.data.role ?? 'BLANK'}</span>{person.data.location && <span>{person.data.location}</span>}</div><h1>{person.data.name}</h1>{person.data.website && <a class="text-link" href={person.data.website} target="_blank" rel="noopener noreferrer">Website <span aria-hidden="true">↗</span></a>}</header>
  <section class="wrap contributor-bio">{person.data.portrait && <img src={person.data.portrait} alt={person.data.portraitAlt ?? 'BLANK'} />}<div class="prose">{person.body?.trim() ? <Content /> : <p>BLANK</p>}</div></section>
  <section class="wrap section"><div class="section-heading"><h2>Read</h2></div>{works.length ? <div class="work-grid">{works.map((work) => <WorkCard work={work} />)}</div> : <p class="archive-empty">BLANK</p>}</section>
</Base>
