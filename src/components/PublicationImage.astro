---
interface Props {
  src?: string;
  alt?: string;
  ratio?: '3 / 4' | '4 / 3';
  fit?: 'contain' | 'cover';
  position?: [number, number];
  priority?: boolean;
  placeholderLabel?: string;
}
const { src, alt = 'BLANK', ratio = '4 / 3', fit = 'contain', position = [50, 50], priority = false, placeholderLabel = 'Unpublished image placeholder' } = Astro.props;
---
<div class:list={['publication-image', { 'cover-placeholder': !src }]} style={{ '--image-ratio': ratio, '--image-fit': fit, '--image-position': `${position[0]}% ${position[1]}%` }}>
  {src ? <img src={src} alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" /> : <span role="img" aria-label={placeholderLabel}>BLANK</span>}
</div>
<style>
  .publication-image { display: grid; place-items: center; position: relative; width: 100%; aspect-ratio: var(--image-ratio); min-width: 0; overflow: hidden; background: var(--white); color: var(--ink); }
  .publication-image img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: var(--image-fit); object-position: var(--image-position); }
  .cover-placeholder { font: 500 clamp(2.5rem,4vw,4rem)/1 var(--display); letter-spacing: -.045em; }
</style>
