---
import '../styles/global.css';
import { site } from '../data/site';
import Motion from '../components/Motion.astro';

interface Props {
  title?: string;
  description?: string;
  className?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  authors?: string[];
  structuredData?: Record<string, unknown>;
}

const { title, description = site.description, className = '', noindex = false, image, imageAlt, type = 'website', publishedAt, authors = [], structuredData } = Astro.props;
const pageTitle = title ? `${title} | Glosso` : 'Glosso';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = image ? new URL(image, Astro.site).href : undefined;
const nav = [
  ['Home', '/'],
  ['Read', '/read/'],
  ['Issues', '/issues/'],
  ['Contributors', '/contributors/'],
  ['About', '/about/'],
  ['Submissions', '/submissions/'],
  ['Contact', '/contact/'],
];
const path = Astro.url.pathname;
const current = (href: string) => href === '/' ? path === href : path === href || path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#00e3c0" />
    <link rel="preload" href="/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Glosso" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {description !== 'BLANK' && <meta property="og:description" content={description} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {authors.map((name) => <meta name="author" content={name} />)}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body class={className}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="wordmark" href="/" aria-label="Glosso home"><span class="brand-symbol"><img src="/art/glosso-frog.png" alt="" width="1200" height="900" /></span><span>Glosso</span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {nav.map(([label, href]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <details class="mobile-menu">
          <summary>Menu <span class="menu-glyph" aria-hidden="true"><i></i><i></i></span></summary>
          <nav aria-label="Mobile navigation">
            {nav.map(([label, href]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}<span aria-hidden="true">↗</span></a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-main">
        <div class="footer-identity"><a href="/" class="footer-wordmark">Glosso</a></div>
        <div class="footer-navigation">
          <nav aria-label="Footer navigation"><a href="/read/">Read</a><a href="/issues/">Issues</a><a href="/contributors/">Contributors</a><a href="/about/">About</a><a href="/submissions/">Submissions</a><a href="/contact/">Contact</a></nav>
          <nav aria-label="Legal navigation"><a href="/legal/privacy/">Privacy Policy</a><a href="/legal/cookies/">Cookie Policy</a><a href="/legal/terms/">Terms and Conditions</a><a href="/legal/disclaimer/">Disclaimer</a></nav>
        </div>
      </div>
      <div class="wrap footer-bottom"><span>Glosso Collective</span><span>© {new Date().getFullYear()}</span></div>
    </footer>
    <Motion />
  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  document.addEventListener('focusin', (event) => {
    // Let keyboard focus leave the disclosure without covering the next link.
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
