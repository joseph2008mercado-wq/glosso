{
  "name": "glosso-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "new:content": "node scripts/new-content.mjs",
    "test:publishing": "node scripts/check-publication.mjs",
    "test:release-build": "node scripts/check-release-build.mjs",
    "test:homepage": "node scripts/check-homepage.mjs && node scripts/check-rendering.mjs",
    "test:images": "node scripts/check-images.mjs --test",
    "test:launch": "node scripts/check-launch-test.mjs",
    "test:security": "node scripts/check-security.mjs",
    "check:public": "node scripts/check-public.mjs",
    "audit:repository": "node scripts/check-repository.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "build:launch": "pnpm build && pnpm audit:repository && pnpm check:launch",
    "dev": "pnpm check:public && astro dev --host 127.0.0.1",
    "build": "pnpm check:public && astro check && astro build && node scripts/check-images.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.2",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "axe-core": "^4.13.0",
    "typescript": "^5.9.0"
  }
}
