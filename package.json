{
  "name": "glosso-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "new:content": "node scripts/new-content.mjs",
    "test:publishing": "node scripts/check-publication.mjs",
    "test:release-build": "node scripts/check-release-build.mjs",
    "test:homepage": "node scripts/check-homepage.mjs && node scripts/check-rendering.mjs",
    "audit:repository": "node scripts/check-repository.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "build:launch": "pnpm build && pnpm audit:repository && pnpm check:launch",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "astro": "^5.14.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.6.2",
    "axe-core": "^4.13.0",
    "typescript": "^5.9.0"
  }
}
